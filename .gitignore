# Local machine configuration — contains absolute SDK paths
local.properties

# Personal scratch: device serial, home server address. See LOCAL_NOTES.md.
LOCAL_NOTES.md

# Gradle / Android build output
.gradle/
build/
captures/
*.iml
.idea/
.cxx/
.externalNativeBuild/
.kotlin/
*.apk
*.aab
