<?xml version="1.0" encoding="utf-8"?>
<!--
    The device seen from directly above, matching the reference render: a cream dome on warm
    beige with five blue lights in a cross.

    Drawn as a vector rather than a bitmap so it stays sharp at every launcher density and the
    adaptive-icon mask can crop it without artefacts. The dome is kept inside the central 66dp
    safe zone, since launchers may mask anything outside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Circles use the "M cx,cy m -r,0 a…" form, so the M must be the CENTRE, not the top.
        Getting that wrong offsets the shape by its own radius and the mask crops it to a lens.
    -->

    <!-- Knurled rim, peeking out from under the dome. -->
    <path android:pathData="M54,54 m-33.6,0 a33.6,33.6 0 1,0 67.2,0 a33.6,33.6 0 1,0 -67.2,0 z"
        android:fillColor="#A79F8B"
        android:fillAlpha="0.55" />

    <!-- Dome body. -->
    <path android:pathData="M54,54 m-33.3,0 a33.3,33.3 0 1,0 66.6,0 a33.3,33.3 0 1,0 -66.6,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44"
                android:centerY="42"
                android:gradientRadius="56">
                <item android:offset="0.0" android:color="#FFF2EFE6" />
                <item android:offset="0.45" android:color="#FFDCD7C8" />
                <item android:offset="0.80" android:color="#FFD0CABA" />
                <item android:offset="1.0" android:color="#FFB0A895" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft matte crown where the light lands. -->
    <path android:pathData="M46,44 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="46"
                android:centerY="44"
                android:gradientRadius="24">
                <item android:offset="0.0" android:color="#59FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Five lights: centre, then up / right / down / left. -->
    <path android:pathData="M54,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="9">
                <item android:offset="0.0" android:color="#B37FB0FF" />
                <item android:offset="1.0" android:color="#007FB0FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,54 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 z"
        android:fillColor="#FFE8F1FF" />

    <path android:pathData="M54,34 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="34" android:gradientRadius="9">
                <item android:offset="0.0" android:color="#B37FB0FF" />
                <item android:offset="1.0" android:color="#007FB0FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,34 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 z"
        android:fillColor="#FFE8F1FF" />

    <path android:pathData="M74,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="74" android:centerY="54" android:gradientRadius="9">
                <item android:offset="0.0" android:color="#B37FB0FF" />
                <item android:offset="1.0" android:color="#007FB0FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M74,54 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 z"
        android:fillColor="#FFE8F1FF" />

    <path android:pathData="M54,74 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="74" android:gradientRadius="9">
                <item android:offset="0.0" android:color="#B37FB0FF" />
                <item android:offset="1.0" android:color="#007FB0FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,74 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 z"
        android:fillColor="#FFE8F1FF" />

    <path android:pathData="M34,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="34" android:centerY="54" android:gradientRadius="9">
                <item android:offset="0.0" android:color="#B37FB0FF" />
                <item android:offset="1.0" android:color="#007FB0FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M34,54 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 z"
        android:fillColor="#FFE8F1FF" />
</vector>
